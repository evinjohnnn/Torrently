# Generate random secrets once: node scripts/init-env.mjs
# Keep .env private; never commit it or run docker compose config unredacted.
BIND_ADDRESS=127.0.0.1
APP_PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
ADMIN_EMAIL=admin@localhost.test
ADMIN_PASSWORD=
SESSION_SECRET=
POSTGRES_PASSWORD=
# Profile-generated Webtor API credential, distinct from its internal API_KEY.
WEBTOR_API_KEY=
WEBTOR_ADMIN_PASSWORD=
WEBTOR_PG_PASSWORD=
WEBTOR_SESSION_SECRET=
WEBTOR_INTERNAL_API_KEY=
WEBTOR_INTERNAL_API_SECRET=
WEBTOR_S3_ACCESS_KEY=
WEBTOR_S3_SECRET_KEY=
TORRENT_CACHE_PATH=./data/torrent-cache
CLEANER_KEEP_FREE=25%
CLEANER_FREE=35%
TORRENT_PEERS_HIGH_WATER=40
TORRENT_PEERS_LOW_WATER=20
MAX_STREAMS=2
MAX_DOWNLOADS=2
MAX_TRANSCODES=1
MAX_TORRENTS=20
MAX_TORRENT_BYTES=2000000
MAX_RESOURCE_BYTES=200000000000
MAX_CACHE_BYTES=300000000000
MIN_FREE_BYTES=50000000000
TRUST_PROXY=false
DISABLE_VIDEO_TRANSCODING=false
APP_MEMORY=768m
POSTGRES_MEMORY=512m
WEBTOR_MEMORY=4g
APP_CPUS=1.0
WEBTOR_CPUS=2.0
# Public profile remains loopback until explicitly configured.
PUBLIC_HOSTNAME=localhost
PUBLIC_BIND_ADDRESS=127.0.0.1

# Upstream flags verified in source; caps are starting estimates, not benchmarks.
ESTABLISHED_CONNS_PER_TORRENT=20
HALF_OPEN_CONNS_PER_TORRENT=8
TOTAL_HALF_OPEN_CONNS=32
PER_TORRENT_CACHE_BUDGET=10GB
MAX_UNVERIFIED_BYTES=32MB
MAX_OPEN_FILES_PER_TORRENT=128
MMAP_MAX_FILE_SIZE=268435456
MMAP_BUDGET_PER_TORRENT=536870912
CLIENT_IDLE_TIMEOUT=10m
MAX_READAHEAD=8MB
STREAM_STALL_TIMEOUT=60s
FFMPEG_THREADS=2
